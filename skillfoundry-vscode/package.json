{
  "name": "skillfoundry",
  "displayName": "SkillFoundry",
  "description": "Quality gates, telemetry dashboard, dependency scanning, and forge pipeline — directly in VS Code",
  "version": "1.4.0",
  "publisher": "skillfoundry",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/samibs/skillfoundry"
  },
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/npm/v/skillfoundry",
      "href": "https://www.npmjs.com/package/skillfoundry",
      "description": "npm version"
    },
    {
      "url": "https://img.shields.io/github/stars/samibs/skillfoundry",
      "href": "https://github.com/samibs/skillfoundry",
      "description": "GitHub stars"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "quality",
    "gates",
    "security",
    "AI",
    "forge",
    "telemetry",
    "skillfoundry"
  ],
  "activationEvents": [
    "workspaceContains:.skillfoundry/config.toml",
    "onCommand:skillfoundry.setup",
    "onCommand:skillfoundry.runExample"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillfoundry",
          "title": "SkillFoundry",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "skillfoundry": [
        {
          "id": "sf.dashboard",
          "name": "Quality Dashboard"
        },
        {
          "id": "sf.gates",
          "name": "Gate Timeline"
        },
        {
          "id": "sf.forge",
          "name": "Forge Monitor"
        },
        {
          "id": "sf.dependencies",
          "name": "Dependencies"
        }
      ]
    },
    "commands": [
      {
        "command": "skillfoundry.setup",
        "title": "SkillFoundry: Setup — Configure API Key"
      },
      {
        "command": "skillfoundry.gateAll",
        "title": "SkillFoundry: Run All Gates"
      },
      {
        "command": "skillfoundry.gate",
        "title": "SkillFoundry: Run Gate"
      },
      {
        "command": "skillfoundry.gateFile",
        "title": "SkillFoundry: Run Gate on This File"
      },
      {
        "command": "skillfoundry.forge",
        "title": "SkillFoundry: Start Forge Pipeline"
      },
      {
        "command": "skillfoundry.runExample",
        "title": "SkillFoundry: Run the Example Project"
      },
      {
        "command": "skillfoundry.metrics",
        "title": "SkillFoundry: Show Metrics"
      },
      {
        "command": "skillfoundry.report",
        "title": "SkillFoundry: View Quality Report"
      },
      {
        "command": "skillfoundry.benchmark",
        "title": "SkillFoundry: Run Benchmark"
      },
      {
        "command": "skillfoundry.hook",
        "title": "SkillFoundry: Manage Hooks"
      },
      {
        "command": "skillfoundry.memory",
        "title": "SkillFoundry: Recall Memory"
      },
      {
        "command": "skillfoundry.prd",
        "title": "SkillFoundry: Create PRD"
      },
      {
        "command": "skillfoundry.scanDeps",
        "title": "SkillFoundry: Scan Dependencies"
      },
      {
        "command": "skillfoundry.openReport",
        "title": "SkillFoundry: Open Last Report"
      },
      {
        "command": "skillfoundry.refresh",
        "title": "SkillFoundry: Refresh Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "skillfoundry.gateAll", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.gate", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.gateFile", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.metrics", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.report", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.benchmark", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.hook", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.memory", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.scanDeps", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.openReport", "when": "config.skillfoundry.showAdvancedCommands" },
        { "command": "skillfoundry.refresh", "when": "config.skillfoundry.showAdvancedCommands" }
      ],
      "editor/context": [
        {
          "command": "skillfoundry.gateFile",
          "group": "skillfoundry"
        }
      ],
      "explorer/context": [
        {
          "command": "skillfoundry.gateFile",
          "group": "skillfoundry"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sf.forge",
        "contents": "Watch a SkillFoundry pipeline run start to finish on a known-good PRD.\n[Run the Example Project](command:skillfoundry.runExample)\nThen point it at your own idea.\n[Create a PRD](command:skillfoundry.prd)\n[Open the Getting Started walkthrough](command:workbench.action.openWalkthrough?%22skillfoundry.skillfoundry%23skillfoundry.gettingStarted%22)"
      },
      {
        "view": "sf.gates",
        "contents": "No gate results yet. Run the example project to see the Anvil quality gates light up live.\n[Run the Example Project](command:skillfoundry.runExample)"
      }
    ],
    "walkthroughs": [
      {
        "id": "skillfoundry.gettingStarted",
        "title": "Get Started with SkillFoundry",
        "description": "Go from install to your first quality-gated build in about five minutes — no need to read the docs first.",
        "steps": [
          {
            "id": "setup",
            "title": "Connect your AI provider",
            "description": "Add your provider key once — stored encrypted in VS Code SecretStorage.\n[Run Setup](command:skillfoundry.setup)",
            "media": { "markdown": "walkthroughs/setup.md" },
            "completionEvents": ["onCommand:skillfoundry.setup"]
          },
          {
            "id": "runExample",
            "title": "Run the example project",
            "description": "Scaffold a ready-made Todo API PRD and run the full pipeline — no configuration needed.\n[Run the Example Project](command:skillfoundry.runExample)",
            "media": { "markdown": "walkthroughs/run-example.md" },
            "completionEvents": ["onCommand:skillfoundry.runExample"]
          },
          {
            "id": "watchGates",
            "title": "Watch the gates run",
            "description": "Open the SkillFoundry view and watch the Forge Monitor light up each phase and gate in real time.\n[Open SkillFoundry](command:workbench.view.extension.skillfoundry)",
            "media": { "markdown": "walkthroughs/watch-gates.md" },
            "completionEvents": ["onView:sf.forge"]
          },
          {
            "id": "yourPrd",
            "title": "Forge your own PRD",
            "description": "Now describe your own idea and build it the same way.\n[Create a PRD](command:skillfoundry.prd)",
            "media": { "markdown": "walkthroughs/your-prd.md" },
            "completionEvents": ["onCommand:skillfoundry.prd"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "SkillFoundry",
      "properties": {
        "skillfoundry.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh dashboard when telemetry changes"
        },
        "skillfoundry.gateTimeout": {
          "type": "number",
          "default": 30,
          "description": "Gate execution timeout in seconds"
        },
        "skillfoundry.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show gate CodeLens actions above code"
        },
        "skillfoundry.inlineDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show gate findings as inline diagnostics"
        },
        "skillfoundry.metricsWindow": {
          "type": "number",
          "default": 10,
          "description": "Default metrics window (last N forge runs)"
        },
        "skillfoundry.showAdvancedCommands": {
          "type": "boolean",
          "default": false,
          "description": "Show all advanced commands (gates, metrics, benchmark, hooks, memory, dependency scan) in the Command Palette. When off, only the core commands — Setup, Run the Example Project, Start Forge Pipeline, and Create PRD — are shown."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
